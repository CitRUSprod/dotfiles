{
    "$schema": "https://opencode.ai/config.json",
    "plugins": ["@sveltejs/opencode"],
    "permissions": [
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "external_directory",
            "resource": "/tmp/*",
            "effect": "allow"
        }
    ],
    "providers": {
        "omniroute": {
            "name": "OmniRoute",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "{{ .opencode.omniroute.baseURL }}",
                "apiKey": "{{ .opencode.omniroute.apiKey }}"
            },
            "models": {
                "super-brain": {
                    "name": "Super Brain",
                    "capabilities": {
                        "tools": true,
                        "input": ["text"],
                        "output": ["text"]
                    }
                },
                "brain": {
                    "name": "Brain",
                    "capabilities": {
                        "tools": true,
                        "input": ["text"],
                        "output": ["text"]
                    }
                },
                "vision": {
                    "name": "Vision",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"]
                    }
                }
            }
        },
        "jan": {
            "name": "Jan",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://localhost:1337/v1"
            },
            "models": {
                "Ornith-1_5-9B-Q4_K_M": {
                    "name": "Ornith 1.5 9B",
                    "capabilities": {
                        "tools": true,
                        "input": ["text", "image"],
                        "output": ["text"]
                    }
                }
            }
        }
    }
}
